<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Todo Master | 6-Week Project</title>

    <!-- Font Awesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✅</text></svg>"
    />

    <!-- CSS -->
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <div class="app-container">
      <!-- ===== HEADER SECTION ===== -->
      <header class="app-header" role="banner">
        <div class="header-content">
          <h1><i class="fas fa-check-circle"></i> Todo Master</h1>
          <p class="subtitle">
            Your productivity companion for the 6-week challenge
          </p>
          <div class="stats">
            <span class="stat-item">
              <i class="fas fa-tasks"></i>
              Total: <span id="totalCount">0</span>
            </span>
            <span class="stat-item">
              <i class="fas fa-check"></i>
              Completed: <span id="completedCount">0</span>
            </span>
            <span class="stat-item">
              <i class="fas fa-clock"></i>
              Pending: <span id="pendingCount">0</span>
            </span>
          </div>
        </div>
      </header>
      <!-- In index.html - Update header -->
<header class="app-header">
  <div class="logo-container">
    <!-- Custom Logo -->
    <img src="assets/logo/logo-medium.png" 
         alt="TODO-IT Logo" 
         class="app-logo"
         width="100" 
         height="100">
    
    <!-- Brand Name with new tagline -->
    <div class="brand-text">
      <h1 class="app-title">TODO-IT</h1>
      <p class="app-tagline">Do it</p>
    </div>
  </div>
  
  <!-- Rest of header content -->
</header>

      <!-- ===== MAIN CONTENT ===== -->
      <main class="app-main" role="main">
        <!-- Input Section -->
        <section class="input-section" aria-labelledby="addTodoHeading">
          <h2 id="addTodoHeading" class="visually-hidden">Add New Todo</h2>

          <div class="input-container">
            <div class="input-group">
              <input
                type="text"
                id="todoInput"
                placeholder="What needs to be done?"
                aria-label="New todo text"
                maxlength="200"
                autocomplete="off"
              />
              <span class="char-count"><span id="charCount">0</span>/200</span>
            </div>

            <!-- Description Toggle Button -->
            <button
              id="toggleDescriptionBtn"
              class="btn-icon"
              type="button"
              title="Add description"
            >
              <i class="fas fa-align-left"></i>
            </button>

            <button id="addBtn" class="btn-primary" aria-label="Add todo">
              <i class="fas fa-plus"></i> Add Task
            </button>
          </div>

          <!-- Description Input (Hidden by default) -->
          <div id="descriptionContainer" class="description-container hidden">
            <textarea
              id="todoDescription"
              placeholder="Add description (optional)"
              rows="3"
              maxlength="500"
              class="description-textarea"
              aria-label="Todo description"
            ></textarea>
            <div class="description-controls">
              <span class="char-count"
                ><span id="descCharCount">0</span>/500</span
              >
              <button
                type="button"
                id="closeDescriptionBtn"
                class="btn-icon small"
                aria-label="Close description"
              >
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>

          <!-- Filter Tabs -->
          <div class="filter-tabs">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="pending">Pending</button>
            <button class="filter-btn" data-filter="completed">
              Completed
            </button>
          </div>
        </section>

        <!-- Todos Section -->
        <section class="todos-section" aria-labelledby="todosHeading">
          <h2 id="todosHeading" class="visually-hidden">Your Todos</h2>

          <!-- Save Order Button -->
          <button
            id="saveOrderBtn"
            class="btn-secondary"
            style="margin-bottom: 15px; width: 100%"
          >
            <i class="fas fa-save"></i> Save Order (Drag & Drop Enabled)
          </button>

          <!-- Loading State -->
          <div id="loadingState" class="loading-state">
            <div class="spinner"></div>
            <p>Loading your todos...</p>
          </div>

          <!-- Empty State -->
          <div id="emptyState" class="empty-state hidden">
            <i class="fas fa-clipboard-list"></i>
            <h3>No todos yet!</h3>
            <p>Add your first task above to get started.</p>
          </div>

          <!-- Error State -->
          <div id="errorState" class="error-state hidden">
            <i class="fas fa-exclamation-triangle"></i>
            <h3>Connection Error</h3>
            <p>Unable to load todos. Please check your backend server.</p>
            <button id="retryBtn" class="btn-secondary">Retry</button>
          </div>

          <!-- Todos List -->
          <ul id="todoList" class="todo-list" aria-label="List of todos">
            <!-- Todo items will be inserted here dynamically -->
          </ul>
        </section>
      </main>

      <!-- ===== FOOTER ===== -->
      <footer class="app-footer" role="contentinfo">
        <div class="footer-content">
          <p>6-Week Todo App Project • Week 3: Advanced Features</p>
          <p class="footer-links">
            <a href="#" aria-label="Keyboard shortcuts"
              ><i class="fas fa-keyboard"></i> Press 'Enter' to add</a
            >
            •
            <a href="#" aria-label="Check backend connection"
              ><i class="fas fa-server"></i> Backend:
              <span id="backendStatus">Checking...</span></a
            >
            •
            <a href="#" aria-label="Drag and drop"
              ><i class="fas fa-arrows-alt"></i> Drag to reorder</a
            >
          </p>
        </div>
      </footer>
    </div>

    <!-- ===== EDIT MODAL ===== -->
    <div
      id="editModal"
      class="modal hidden"
      role="dialog"
      aria-labelledby="editModalTitle"
    >
      <div class="modal-content">
        <h3 id="editModalTitle">Edit Todo</h3>

        <!-- Title Input -->
        <input
          type="text"
          id="editTodoInput"
          placeholder="Todo title..."
          aria-label="Edit todo title"
          class="modal-input"
        />

        <!-- Description Input -->
        <textarea
          id="editTodoDescription"
          placeholder="Description (optional)"
          rows="4"
          maxlength="500"
          class="modal-textarea"
          aria-label="Edit todo description"
        ></textarea>
        <div class="modal-char-count">
          <span id="editDescCharCount">0</span>/500
        </div>

        <div class="modal-actions">
          <button id="cancelEditBtn" class="btn-secondary">Cancel</button>
          <button id="saveEditBtn" class="btn-primary">Save Changes</button>
        </div>
      </div>
    </div>

    <!-- ===== JAVASCRIPT ===== -->
    <script src="script.js"></script>
  </body>
</html>
